VITE_API_URL=http://localhost:5000/api

# Paystack test public key (safe to expose in frontend code)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth Client ID - for "Sign in with Google" (console.cloud.google.com -> APIs & Services -> Credentials)
# Must match GOOGLE_CLIENT_ID in backend/.env exactly. Leave unset to hide the button.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
