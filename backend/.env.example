PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string (Atlas free tier or local mongod)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budgetmate?retryWrites=true&w=majority"

# Long random string used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="30m"

# Paystack test secret key (Settings -> API Keys & Webhooks in the Paystack dashboard)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Gemini API key for the in-app AI assistant (aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SendGrid - for the "forgot password" reset email (app.sendgrid.com -> Settings -> API Keys)
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an email address verified under Settings -> Sender Authentication -> Single Sender Verification
SENDGRID_FROM_EMAIL="you@example.com"
