PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string (Atlas free tier or local mongod)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budgetmate?retryWrites=true&w=majority"

# Long random string used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="30m"

# Paystack test secret key (Settings -> API Keys & Webhooks in the Paystack dashboard)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
